# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/

# Compiled extensions (built per-machine; see README libcerf section)
*.so

# Test / tooling caches
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/

# Notebooks
.ipynb_checkpoints/

# Editors
.vscode/
.idea/
*.swp
*~

# Environment
.env
.envrc

# Private / restricted paths and data
# - private/* ignores file contents of private/ (must use /* not / so un-ignore works)
# - templates (*.template) and .gitkeep are un-ignored so structure is documented
private/*
!private/*.template
!private/.gitkeep

# Generated outputs / large artifacts
figures/
out/
processed/
*.h5
*.hdf5
!data/**/*.h5
!data/**/*.hdf5
!tests/**/*.h5

# Trained-model + training-history artifacts. .npz files under docs/notes/
# are large and regenerable from the trainer; only fixtures under tests/
# are tracked.
*.npz
!data/**/*.npz
!tests/**/*.npz

# SLURM job logs (regenerated per submission)
slurm/greatlakes/*.log

# Transient scheduler lock files
.claude/*.lock

# Per-target raw result artifacts (regenerated by examples/run_tau_eb_*.py
# and the SLURM array runners; too bulky for git history). The headline
# summary CSVs (phase_b_aggregate.csv etc.) are kept; the per-target TSVs
# and the GPU/CPU profiler trace JSONs (~MB-GB) are not.
tests/profile/results/*.tsv
tests/profile/results/trace_*.json

# SLURM job logs in any greatlakes subdir (the old slurm/greatlakes/*.log missed production/logs/)
slurm/greatlakes/**/*.log

# Claude-oriented working docs (investigation notes, run notes, per-mock stories,
# session handoffs, design memos) live in the SEPARATE private notes repo to keep the
# code repo clean for Claude. See docs/NOTES_MOVED_TO_PRIVATE.md for where to find them.
docs/notes/
docs/handoffs/
docs/runs/
docs/stories/
docs/superpowers/
docs/voigt_lsf_sweep_plan.md

# Step A trainset fixtures regenerable from build_2lpt_frozen_test_fixture.py
tests/fixtures/2lpt_frozen/training_set.mat
tests/fixtures/2lpt_frozen/training_set.npz

# Phase 2 DR16 cache (re-buildable from build_data_cache())
tests/fixtures/dr16_pca_init.npz
tests/fixtures/dr16_phase2_cache/
docs/notes/2026-05-08_matlab_dr16_validation/phase2_result.npz

# --- local scratch / transient artifacts (not for git history) ---
# downloaded raw mock spectra (bulky, regenerable)
data/raw_spectra/
# stray local test artifact
/dummy_catalog.npy
# SLURM job stderr (regenerated per submission)
slurm/greatlakes/**/*.err
# local prototype figure scratch
examples/prototype_dla_clustering.png

# but DO track the published hbi headline figures (the deliverable; overrides the broad `figures/` rule)
!CDDF_analysis/hbi/figures/
!CDDF_analysis/hbi/figures/*.png

# Per-healpix QSO spec-count tables hold catalog counts -> keep on CFS, never commit.
# Regenerate with tools/loa_hpx_spec_counts.py (see loa_cddf_nersc.env / matterhorn_nersc_v1.env).
# Covers *_qso_counts.txt (matterhorn) and *_spec_counts.txt (loa).
slurm/nersc/production/*_counts.txt
