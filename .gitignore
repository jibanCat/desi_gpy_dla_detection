# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/

# Compiled extensions (built per-machine; see README libcerf section)
*.so

# Test / tooling caches
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/

# Notebooks
.ipynb_checkpoints/

# Editors
.vscode/
.idea/
*.swp
*~

# Environment
.env
.envrc

# Private / restricted paths and data
# - private/* ignores file contents of private/ (must use /* not / so un-ignore works)
# - templates (*.template) and .gitkeep are un-ignored so structure is documented
private/*
!private/*.template
!private/.gitkeep

# Generated outputs / large artifacts
figures/
out/
processed/
*.h5
*.hdf5
!data/**/*.h5
!data/**/*.hdf5
!tests/**/*.h5

# Trained-model + training-history artifacts. .npz files under docs/notes/
# are large and regenerable from the trainer; only fixtures under tests/
# are tracked.
*.npz
!data/**/*.npz
!tests/**/*.npz

# SLURM job logs (regenerated per submission)
slurm/greatlakes/*.log

# Claude / agent working context: keep LOCAL, never publish. The owner keeps these
# on disk so future Claude Code sessions read them, but they are internal working
# artifacts, not part of the shipped tool.
CLAUDE.md
.claude/
.superpowers/

# Editor / OS cruft
.DS_Store
Thumbs.db
*.orig
*.bak

# Per-target raw result artifacts (regenerated by examples/run_tau_eb_*.py
# and the SLURM array runners; too bulky for git history). The headline
# summary CSVs (phase_b_aggregate.csv etc.) are kept; the per-target TSVs
# and the GPU/CPU profiler trace JSONs (~MB-GB) are not.
tests/profile/results/*.tsv
tests/profile/results/trace_*.json

# SLURM job logs in any greatlakes subdir (the old slurm/greatlakes/*.log missed production/logs/)
slurm/greatlakes/**/*.log

# Claude-oriented working docs (investigation notes, run notes, per-mock stories,
# session handoffs, design memos) live in the SEPARATE private notes repo to keep the
# code repo clean for Claude. See docs/NOTES_MOVED_TO_PRIVATE.md for where to find them.
docs/notes/
docs/handoffs/
docs/runs/
docs/stories/
docs/superpowers/
docs/voigt_lsf_sweep_plan.md

# Step A trainset fixtures regenerable from build_2lpt_frozen_test_fixture.py
tests/fixtures/2lpt_frozen/training_set.mat
tests/fixtures/2lpt_frozen/training_set.npz

# Phase 2 DR16 cache (re-buildable from build_data_cache())
tests/fixtures/dr16_pca_init.npz
tests/fixtures/dr16_phase2_cache/
docs/notes/2026-05-08_matlab_dr16_validation/phase2_result.npz

# --- local scratch / transient artifacts (not for git history) ---
# downloaded raw mock spectra (bulky, regenerable)
data/raw_spectra/
# stray local test artifact
/dummy_catalog.npy
# SLURM job stderr (regenerated per submission)
slurm/greatlakes/**/*.err
# local prototype figure scratch
examples/prototype_dla_clustering.png

# but DO track the published hbi headline figures (the deliverable; overrides the broad `figures/` rule)
!CDDF_analysis/hbi/figures/
!CDDF_analysis/hbi/figures/*.png

# Per-healpix QSO spec-count tables hold catalog counts -> keep on CFS, never commit.
# Regenerate with tools/loa_hpx_spec_counts.py (see loa_cddf_nersc.env / matterhorn_nersc_v1.env).
# Covers *_qso_counts.txt (matterhorn) and *_spec_counts.txt (loa).
slurm/nersc/production/*_counts.txt

# LLS recovery PNGs live in the private notes repo (jibanCat/desi_gpy_dla_notes), not here.
# Narrow rule: do NOT re-ignore CDDF_analysis/hbi/figures/ (tracked headline deliverables, see above).
# The stamped JSON (the numbers) stays in-repo; regenerate PNGs via lls_recovery_figures.py --force
CDDF_analysis/hbi/figures/lls_recovery/

# Executed unblinding notebooks contain real-LOA values (private). Only outputs-stripped
# sources belong in git; executed copies and probes never do.
notebooks/*probe*.ipynb
notebooks/*.exec.ipynb
notebooks/*.executed.ipynb

# --- Retired / superseded HBI artifacts: PRESENT LOCALLY, NEVER COMMITTED -------------
# These six files are untracked ON PURPOSE and are LOAD-BEARING. Do not "tidy them up".
# Measured 2026-08-05 (env gpdla, tests/test_tombstones.py + test_subdla_forward_headline.py
# + test_unblind_audit.py, baseline 65 passed / 0 skipped):
#
#   * deleting the four retired identities  -> 59 passed, 6 SKIPPED: the byte-level half of
#     the tombstone fingerprint guard goes inert (it compares the record's sha256/bytes
#     against the physical file, which only this worktree holds).
#   * deleting the two crossmock JSONs      -> HARD FAILURE: build_tombstones.py --check
#     refuses to write a half-armed tombstone without both sides of the tripwire.
#
# They must also never be COMMITTED: each retired identity carries
# successor_policy.must_not_reuse_identity=true, and committing at these paths is the
# "resurrection" that tests/test_tombstones.py::test_tombstoned_identity_is_not_resurrected
# exists to catch. Ignoring is not tracking, so that guard still holds.
# A successor measurement goes to a NEW path -- see CDDF_analysis/hbi/tombstones/SCHEMA.md.
CDDF_analysis/hbi/lls_recovery_figures.json
CDDF_analysis/hbi/subdla_edge_systematic.json
CDDF_analysis/hbi/subdla_floor_mc_band.json
CDDF_analysis/hbi/subdla_mock_headline.json
CDDF_analysis/hbi/crossmock_transfer.json
CDDF_analysis/hbi/crossmock_transfer_loa0.json
