# london0_gl_eboss_kamble_notaueb.env — eBOSS legacy model with its CORRECT
# native mean-flux = Kamble+2020 (0.00554/3.182), τ-EB OFF, same 2-file slice.
# Fixes the earlier eBOSS control which wrongly used Kim+2007 (0.0023/3.65).
source "$(dirname "${BASH_SOURCE[0]}")/london0_gl_eboss_notaueb.env"
PREV_TAU_0=0.00554
PREV_BETA=3.182
RUN_NAME="gl_eboss_kamble_notaueb_london0_${RUN_DATE}"
OUTDIR="${GL_OUTPUT_ROOT}/${RUN_NAME}/outputs/"
