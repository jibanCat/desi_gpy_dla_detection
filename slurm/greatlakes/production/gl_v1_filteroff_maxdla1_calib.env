# gl_v1_filteroff_maxdla1_calib.env — TEMP calibration (2026-05-26; not for production).
# V1 config (fixed code) but FILTER_LOW_LIKELIHOOD=0 AND MAX_DLAS=1: the dense-1-DLA CDDF run.
# Computes the full 100k samples for the 1-DLA model only (no 2/3/4-DLA cascade) → dense 1-DLA
# posterior for the Pathway-A CDDF, at a fraction of the full FILTER-off cost. Used to MEASURE
# CPU-sec/spectrum + MB/spectrum for the CDDF-run cost estimate.
source "$(dirname "${BASH_SOURCE[0]}")/london0_gl_v1.env"
FILTER_LOW_LIKELIHOOD=0
MAX_DLAS=1
RUN_NAME="gl_v1_filteroff_maxdla1_calib_${RUN_DATE}"
OUTDIR="${GL_OUTPUT_ROOT}/${RUN_NAME}/outputs/"
