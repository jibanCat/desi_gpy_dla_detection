# wall1_inject_gl_v1.env — WALL-1 FULL-INJECTION re-inference (GreatLakes).
#
# PURPOSE (notes/2026-06-17_wall1_full_injection_design.md):
#   Re-run the UNMODIFIED production GP on a tilted-f(N) injection arm (loa-0
#   substrate, one absorber/sightline drawn from f(N)_2LPT × 10^(Δα(logN−20.3))),
#   so the HBI can apply the FROZEN untilted R_emp kernel + frozen molly C/ρ to a
#   GENUINELY re-inferred tilted population and check WALL-1 closure (IS-faithfulness
#   + is-the-FAIL-real).
#
# INFERENCE FAITHFULNESS (hard discipline — design §5, §7):
#   This is a config-only CLONE of loa0_fp_gl_v1.env -> 2lpt0_gl_v1.env, the EXACT
#   production config the frozen kernel + molly C/ρ were calibrated on. It changes
#   ONLY the data pointer (MOCKDIR -> the injectable arm tree; QSOCAT -> the arm's
#   restricted pilot_qsocat.fits) and the output dir. EVERY inference parameter
#   (learned model 2lpt_loa124_nohcd_nobal_wide_m, MAX_DLAS=4, SINGLE_ABSORBER_MODEL=1,
#   FILTER_LOW_LIKELIHOOD=1, NUM_FOREST_LINES=31, MAX_LAMBDA=1250, PW 100k [17.2,22.5],
#   τ-EB null, +log(N), MIN_Z_SEPARATION, K, DLAMBDA, …) is INHERITED UNCHANGED.
#   This is DELIBERATELY NOT the M3 FILTER-off maxdla1 config (run_gp_injection.sh) —
#   that downstream mismatches the frozen kernel/molly calibration (design §7, "the
#   most likely silent-bias trap"). dla_gp.py / run_bayes_select.py are byte-untouched.
#
#   NOTE: the injectable tree has NO hcd/dla/bal catalogs (loa-0 is clean + the arm's
#   own truth is the injected manifest, written separately as injected_truth_cat.fits
#   under the arm root). The truth/bal refs unset below are downstream-eval-only and
#   never passed to desi-DLAGP.py (verified in launch_gl.sh / submit_desi_mock_gl.sh).
#
# Source order (identical inference chain to production, plus our data overrides):
#   loa0_fp_gl_v1.env -> 2lpt0_gl_v1.env -> london0_gl_v1.env -> _base_gl.env
source "$(dirname "${BASH_SOURCE[0]}")/loa0_fp_gl_v1.env"

# --- ONLY-CHANGES vs loa0_fp_gl_v1.env ---------------------------------------

# 1) Point at the injectable ARM tree (set WALL1_ARM to the gen_wall1_inject --out
#    root). The GP scans ${MOCKDIR}/spectra-16/ exactly as for a real mock.
WALL1_ARM="${WALL1_ARM:?set WALL1_ARM=<gen_wall1_inject --out tree root>}"
MOCKDIR="${WALL1_ARM}"
# 2) Restricted qsocat = ONLY the injected targets (written by gen_wall1_inject).
QSOCAT="${WALL1_ARM}/pilot_qsocat.fits"

# 3) Output dir under the arm tree (keeps the arm self-contained; allowed GL root).
OUTDIR="${WALL1_ARM}/gp_out/"

# 4) Healpix index window: the injectable tree has only the injected healpix subset.
#    desi-DLAGP.py --mocks sorts the spectra-16-*.fits list and slices [start:end], so
#    the loop is POSITIONAL over the arm's files (not raw healpix numbers). The arm
#    has at most ~tens of healpix; OUTER_MAX_INDEX/OUTER_WINDOW are sized by the
#    launcher (--end N --window N) from the actual file count.
OUTER_MAX_INDEX="${OUTER_MAX_INDEX:-200}"
OUTER_STEP="${OUTER_STEP:-12}"
OUTER_WINDOW="${OUTER_WINDOW:-10}"

# 5) Drop the loa-124 truth/bal refs inherited via 2lpt0_gl_v1.env (the arm has its
#    own injected_truth_cat.fits; these are downstream-eval-only, never inference args).
unset TRUTH_CAT
unset BAL_CAT

# SLURM account stays cavestru1 (inherited from loa0_fp_gl_v1.env). BALMASK=false.
