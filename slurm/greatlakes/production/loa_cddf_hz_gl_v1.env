# slurm/greatlakes/production/loa_cddf_hz_gl_v1.env
# GL flavour of the frozen high-z incremental CDDF production
# (PI ruling 2026-08-13: L-A approved — the verified LoaArchive is the
# spectral substrate; no raw-coadd transfer).
#
# Sources the frozen NERSC hz flavour (science identity: CDDF finder config
# + GPDLA_ZMIN_QSO=4.25 / GPDLA_ZMAX_QSO=7.0) and re-points SITE PLUMBING
# ONLY: data/model/catalog locations, output root, allocation, task sizing.
# No science knob is changed here — every finder parameter flows through
# unchanged from loa_cddf_hz_v1.env / loa_cddf_nersc.env / loa_nersc_v1.env.
#
# Launch (documented chain, launch_nersc.sh assembles the export + sbatch):
#   EXTERNAL_HPX_LIST=<production_hpx_list> \
#   GPDLA_SPECTRA_ARCHIVE=<verified loa_hz_archive_v1.h5> \
#   SBATCH_PARTITION=standard \
#   bash slurm/nersc/production/launch_nersc.sh \
#        slurm/greatlakes/production/loa_cddf_hz_gl_v1.env \
#        --start 0 --end <n_hpx> --window <n_hpx> --time 12:00:00

source "$(dirname "${BASH_SOURCE[0]}")/../../nersc/production/loa_cddf_hz_v1.env"

# --- GL site plumbing (I/O + scheduler only) ---------------------------------
QSOCAT="/nfs/turbo/lsa-cavestru/mfho/DESI/loa/QSO_cat_loa_main_dark_healpix_v2-altbal.fits"
LEARNED_FILE="/nfs/turbo/lsa-cavestru/mfho/DESI/GP_trained/DEPLOYED_phase2_2lpt_loa124_nohcd_nobal_wide_m/phase2_result.h5"
# Option-B balance table is a NERSC/CFS artifact; equal-count split on GL
# (scheduling only; coverage identical).
LOA_BALANCE_COUNTS=
# GL scratch output root + allowed write prefix
NERSC_OUTPUT_ROOT="/scratch/cavestru_root/cavestru0/mfho/loa_hz_production"
# (GL /scratch resolves to /gpfs/accounts/... — allow the resolved form)
NERSC_ALLOWED_OUTPUT_PREFIXES="/gpfs/accounts/cavestru_root/cavestru0/mfho/"
OUTDIR="${OUTDIR_OVERRIDE:-${NERSC_OUTPUT_ROOT}/gl_cddf_loa_hz_v1_${RUN_DATE}/outputs}"
# Allocation HARD RULE (PI): cavestru0 or yueyingn0 ONLY — never cavestru1.
NERSC_SLURM_ACCOUNT="cavestru0"
NERSC_SLURM_QOS="normal"
NERSC_SLURM_CONSTRAINT=""
NERSC_SLURM_TIME="12:00:00"
# GL standard-node sizing (36 cores / 180 GB): 16 tasks x 2 workers.
NERSC_NTASKS=16
MAX_WORKERS=2
# GL runtime for the driver branch (replaces the NERSC desiconda source):
NERSC_ENV_SETUP="source /sw/pkgs/arc/mamba/py3.11/etc/profile.d/conda.sh && conda activate gpdla && export HDF5_USE_FILE_LOCKING=FALSE"
