# 2lpt0_gl_v1_filteroff_maxdla1.env — dense-1-DLA CDDF run on the 2LPT mock-0 (loa-124).
# = 2lpt0_gl_v1.env but FILTER_LOW_LIKELIHOOD=0 and MAX_DLAS=1: computes the full 100k QMC samples
# for the 1-DLA model only (dense, 0% NaN → usable for the Pathway-A Bayesian CDDF), dropping the
# multi-DLA cascade for cost. Pairs with the FILTER-on baseline (2lpt0_gl_v1.env) which provides the
# multi-DLA catalog. Same model/grid/τ-EB; BALMASK=false.
source "$(dirname "${BASH_SOURCE[0]}")/2lpt0_gl_v1.env"
FILTER_LOW_LIKELIHOOD=0
MAX_DLAS=1
RUN_NAME="gl_cddf_2lpt0_v1_filteroff_maxdla1_${RUN_DATE}"
OUTDIR="${GL_OUTPUT_ROOT}/${RUN_NAME}/outputs/"
