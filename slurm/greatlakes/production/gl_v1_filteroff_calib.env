# gl_v1_filteroff_calib.env — TEMP calibration config (2026-05-25; not for production).
# V1 production config (fixed code via the main-tree GL_REPO) but FILTER_LOW_LIKELIHOOD=0,
# so the full 100k samples are computed for every k → dense per-sample posteriors for the
# Bayesian (Pathway-A) CDDF. Used to measure FILTER-off cost (CPU + on-disk) and the dense
# CDDF vs the FILTER-on 5k validation, on a subset of the same healpix.
source "$(dirname "${BASH_SOURCE[0]}")/london0_gl_v1.env"
FILTER_LOW_LIKELIHOOD=0
RUN_NAME="gl_v1_filteroff_calib_${RUN_DATE}"
OUTDIR="${GL_OUTPUT_ROOT}/${RUN_NAME}/outputs/"
