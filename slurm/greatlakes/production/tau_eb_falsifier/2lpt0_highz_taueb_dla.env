# tau_eb_falsifier/2lpt0_highz_taueb_dla.env
# Track C tau_eb high-z falsifier — ARM B (STRONGER LEVER).
#
# CONTEXT: the V1 baseline ran tau_eb ON with the cheap "null" objective. This
# arm runs the more rigorous "dla" objective (max over a (z_DLA, log N_HI) grid
# of log p(D|1-DLA GP) on HCD-masked pixels — the validated diagnostic recipe,
# tau_eb.py docstring). It tests whether a *stronger* per-spectrum forest-floor
# correction shrinks the residual +0.038 dex DLA-tier NHI bias further, esp. at
# high z where the forest floor rises into the damping wing.
#   - if bias SHRINKS (and more at high z) => cause is upstream forest-blend,
#                                              tau_eb is the right lever;
#   - if bias UNCHANGED vs null            => residual bias is prior-edge pileup,
#                                              kernel / 2-D-C is the only lever.
#
# IDENTICAL to 2lpt0_gl_v1.env EXCEPT: TAU_EB_OBJECTIVE=dla (still ON) +
# restricted to the high-z host TID subset. No inference-code change.
# NOTE: the "dla" objective is ~K times more expensive than "null" per the
# tau_eb.py docstring (each tau grid point needs a DLAGPMAT build + grid scan).
# Cost is still bounded by the 903-TID subset; budget headroom below 100 CPU-h.
source "$(dirname "${BASH_SOURCE[0]}")/../2lpt0_gl_v1.env"

ENABLE_TAU_EB=1
TAU_EB_OBJECTIVE=dla
RUN_NAME="gl_taueb_falsifier_2lpt0_highz_DLAOBJ_${RUN_DATE}"
OUTDIR="${GL_OUTPUT_ROOT}/${RUN_NAME}/outputs/"

EXTERNAL_TID_LIST="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/highz_upmig_hosts.txt"
