# slurm/greatlakes/production/london0_gl_v1.env
# GreatLakes London-0 mock, V1 production candidate (PR #7 headline).
#
# Targets reproduction of the published P/C numbers from PR #7's
# 2026-05-19 matcher-fix headline:
#   - Purity:       0.8357   (NHI-desc matcher)
#   - Completeness: 0.8978
# on the 5k slice (n_truth = 581).
#
# Config (per PR #7 description, "Updated headline P/C — V1 production
# candidate" section):
#   - LEARNED_FILE: 2lpt_loa124_nohcd_nobal_wide_m (matched norm band)
#   - MAX_LAMBDA: 1250 (overrides _base.env default 1216.75)
#   - PW 100k DLA prior, NHI [17.2, 22.5] (production best baseline)
#   - MAX_DLAS=3, SINGLE_ABSORBER_MODEL=1 (2-way single-absorber)
#   - τ-EB ON with the *null* objective (ENABLE_TAU_EB=1,
#     TAU_EB_OBJECTIVE=null) — "τ-EB null" in the PR means the null
#     objective, NOT τ-EB off. The runbook §10.1 gotcha: the NERSC
#     submit scripts silently drop these flags; submit_desi_mock_gl.sh
#     forwards them explicitly.
#   - +log(N) log-evidence patch ON (in production_533 code)
#   - FILTER_LOW_LIKELIHOOD=1 (PR #5 FILTER fix #5)
#   - BALMASK=false (BAL QSOs included)
#
# Open ambiguity: PR #7 description says model "_wide_m", but
# docs/notes/2026-05-16_lambda_fine_and_gp_range.md and
# docs/notes/2026-05-16_config_confirmations.md both write the model
# name as "2lpt_loa124_nohcd_nobal_wide" (no _m). The PR description is
# the most recent authoritative source, so we use _wide_m here; if the
# replicated P/C deviates significantly from 0.8357/0.8978, switch to
# the _wide variant (norm band [1310,1325] vs [1425,1475]).
#
# Source order:
#   source "$(dirname "${BASH_SOURCE[0]}")/_base_gl.env"   # GL paths + NERSC sci defaults

source "$(dirname "${BASH_SOURCE[0]}")/_base_gl.env"

MODE="mock"
RUN_DATE="${RUN_DATE:-$(date +%Y%m%d)}"
RUN_NAME="${RUN_NAME:-gl_prod_smoke_london0_v1_${RUN_DATE}}"

# --- Mock data on Turbo ------------------------------------------------------
MOCKDIR="/nfs/turbo/lsa-cavestru/mfho/DESI/mocks/london/qq_desi_y3/v5.9.5/mock-0/jura-124"
QSOCAT="${MOCKDIR}/zcat.fits"
RELEASE="v5.9.5"

# --- Output landing on /scratch ----------------------------------------------
OUTDIR="${OUTDIR:-${GL_OUTPUT_ROOT}/${RUN_NAME}/outputs/}"

# --- V1 candidate model (different from _base_gl.env default) ----------------
LEARNED_FILE="${GL_MODEL_ROOT}/2lpt_loa124_nohcd_nobal_wide_m/phase2_result.h5"

# --- NUM_FOREST_LINES must MATCH training (overrides _base.env default 3) -----
# The 2lpt models were trained with de_forest_num_lines=31 (deep Lyman series;
# tests/phase2_train_desi.py:67/655 — verified 2026-05-22). At inference,
# num_forest_lines re-suppresses mu/M AND scales Ω² (null_gp.py:259/260/277/282)
# and is reused by τ-EB. Running inference at 3 (the _base.env default) mis-models
# the mean-flux on BOTH mu and the noise → biases log NHI HIGH (~+0.06 dex).
# Set to 31 to match training. (See memory: gl-diagnostics-clustering.)
NUM_FOREST_LINES=31

# --- Absorber-mode knobs (V1 = 2-way single-absorber) -----------------------
# MAX_DLAS=4 to match the DESI DLA catalog DR2 production run. Sensitivity test
# (2026-05-22, gl_maxdla4_london0_v1): vs MAX_DLAS=3, P/C ~unchanged
# (0.8201/0.9038 vs 0.8179/0.9038) and ~+19% per-spectrum cost (only on the
# multi-DLA tail; median per-spec identical). Adopted for DR2 consistency.
MAX_DLAS=4
SINGLE_ABSORBER_MODEL=1
FILTER_LOW_LIKELIHOOD=1

# --- τ-EB ON / null objective (production best baseline) ---------------------
ENABLE_TAU_EB=1
TAU_EB_OBJECTIVE=null
EARLY_STOP_MODE=baseline

# --- MAX_LAMBDA override (V1: 1250 vs _base default 1216.75) -----------------
MAX_LAMBDA=1250

# --- PW 100k DLA prior (NHI 17.2-22.5) — production best baseline -----------
# Runbook "Current production decisions" (2026-05-19): PW 100k + NHI ceiling
# extended to 22.5 so rare NHI>22 DLAs aren't clipped low. Files copied to
# cavestru scratch 2026-05-21. Expected P/C ~0.84-0.85 / ~0.90-0.91 (the
# exact 0.8357/0.8978 headline was the PW 50k / [17.2,22.0] measurement).
DLA_SAMPLES_FILE="${GL_DATA_ROOT}/data/dr12q/processed/pw_samples_a3_172_225_100000.mat"
SUB_DLA_SAMPLES_FILE="${GL_DATA_ROOT}/data/dr12q/processed/subdla_samples_a03_191_200_100000.mat"
NUM_DLA_SAMPLES=100000
NUM_SUBDLA_SAMPLES=100000

# --- Outer-loop window (London mock-0 has 1150 spectra-16 files) -------------
# Sized for the N=2 × W=16 packing: only 2 srun's run concurrently, and one
# 2-file slice ≈ 1081 spectra × ~3.7 s ≈ 67 min serial. A window of OUTER_WINDOW
# slices runs in ceil(slices/2) waves; keep it under the 8 h -t. 10 slices →
# 5 waves × ~67 min ≈ 5.6 h (headroom for DLA-heavy slices). OUTER_STEP must be
# OUTER_WINDOW+2 to tile without gaps. For the 5k validation run, override at
# launch (e.g. launch_gl.sh ... --start 0 --end 0 --window 8 ≈ 5 slices/5.4k
# spectra). For the full mock, raise -t (partition allows 14 d) or add sbatches.
OUTER_MAX_INDEX=1150
# RE-RUN FIX (2026-05-23): the first production attempt
# (gl_prod_london0_v1_preclustering_20260522) lost 16 jobs to the 8 h -t at
# OUTER_WINDOW=20 (≈5.6 h estimated, but DLA-heavy slices + the 53-job concurrent
# disk-write storm pushed several over 8 h). Halve the per-sbatch chunk to 5
# slices (≈3 waves × ~67 min ≈ 3.4 h) AND raise -t to 12 h (GL_SLURM_TIME below).
# OUTER_STEP must stay OUTER_WINDOW+2 to tile without gaps.
OUTER_STEP=12
OUTER_WINDOW=10      # 5 × 2 — smaller chunk, finishes well under the 12 h -t

# --- SLURM scheduler overrides (re-run fixes; see _base_gl.env / launch_gl.sh) -
# -t 8 h → 12 h: headroom for the slices that timed out above.
# --mem 64G → 128G: the first attempt OOM'd 9 steps at 64G (N=2 × W=16 inner
# workers × 100k samples ≈ 2 GB/worker hit the edge). 128G ≈ 4 GB/worker.
GL_SLURM_TIME=12:00:00
GL_SLURM_MEM=128G

# --- Parallelism (tuned on GL standard via pinned concurrency sweep) ---------
# Optimum = N=2 srun's × W=16 inner workers = 32 cores/sbatch, BLAS pinned to
# 1 thread (submit_desi_mock_gl.sh sets -n 2 -c 16 + the thread-pin exports;
# SRUN_CPUS defaults to MAX_WORKERS). Pinned concurrency sweep (jobs
# 50635651/50638321): N2×W16 = 32.6 spec/min, the throughput peak — 3× the old
# N8×W4 and ~100× the single-spectrum-latency pick (N32×W1). Two spectra in
# flight overlap serial/parallel phases with low memory-bandwidth contention.
MAX_WORKERS=16
BATCH_SIZE=1250

# --- Truth catalog for downstream P/C eval ---------------------------------
TRUTH_CAT="${MOCKDIR}/dla_cat.fits"
TRUTH_NHI_MIN=20.3
BAL_CAT="${MOCKDIR}/bal_cat.fits"
