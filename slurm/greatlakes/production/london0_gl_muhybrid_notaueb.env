# london0_gl_muhybrid_notaueb.env — mu-only retrain test. Identical to V1 (DESI
# grid, Turner mean-flux, NF=31) with τ-EB OFF, but LEARNED_FILE = the hybrid
# model whose mu was re-derived by de-foresting the 2lpt training data with the
# CLEAN loa-0 Lya mean-flux (0.01258/2.385) instead of Turner (M/Omega unchanged).
# Compare ΔNHI to the DESI-Turner τEB-off baseline (+0.044) to see if removing
# the de-forest residual in mu mitigates the NHI bias. (eBOSS evidence predicts ~no change.)
source "$(dirname "${BASH_SOURCE[0]}")/london0_gl_v1.env"
LEARNED_FILE="/scratch/cavestru_root/cavestru0/mfho/mu_rederive/phase2_result_mu2lpt_clean.h5"
ENABLE_TAU_EB=0
RUN_NAME="gl_muhybrid_notaueb_london0_${RUN_DATE}"
OUTDIR="${GL_OUTPUT_ROOT}/${RUN_NAME}/outputs/"
