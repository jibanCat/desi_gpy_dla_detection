# gl_withbal_5k.env — BAL-trained-model test (2026-05-26).
# V1 config but LEARNED_FILE = the BAL-trained model
# (loa_no_hcd_with_bal_wide_m_normmask_3000iter: real-LOA, trained WITH BAL spectra; grid 850.75-1700,
# dλ0.15, norm band [1425,1475] — matches V1). No masking (BALMASK=false): let the GP mean/covariance
# account for BAL features rather than zeroing pixels.
# CONFOUND: this model differs from the V1 2lpt model by training data (LOA vs 2lpt), normmask, and
# iters (3000 vs 1500) too — so a P/C difference is NOT bal-inclusion alone. Directional test of
# "does a BAL-trained model give better BAL-only P/C?".
source "$(dirname "${BASH_SOURCE[0]}")/london0_gl_v1.env"
LEARNED_FILE="${GL_MODEL_ROOT}/loa_no_hcd_with_bal_wide_m_normmask_3000iter/phase2_result.h5"
BALMASK=false
RUN_NAME="gl_withbal_5k_${RUN_DATE}"
OUTDIR="${GL_OUTPUT_ROOT}/${RUN_NAME}/outputs/"
