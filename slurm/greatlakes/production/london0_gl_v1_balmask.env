# london0_gl_v1_balmask.env — BAL-masking smoke test (2026-05-26).
# V1 production config (fixed code via the main-tree GL_REPO) but BALMASK=true, so
# --balmask is passed: BAL trough pixels (AI_CIV / NCIV_450 / VMIN_CIV_450 / VMAX_CIV_450
# from bal_cat.fits, 17 BAL lines) are masked per-spectrum before the GP likelihood.
# Compared against the FILTER-on baseline (gl_v1_logZfix_5k, BALMASK=false) on the same
# healpix, evaluated both BAL-included and BAL-excluded (Molly --no-bal, BI_CIV>0).
source "$(dirname "${BASH_SOURCE[0]}")/london0_gl_v1.env"
BALMASK=true
RUN_NAME="gl_v1_balmaskfix_5k_${RUN_DATE}"   # FIXED order-agnostic mask (2026-05-26); distinct from the void broken-mask run
OUTDIR="${GL_OUTPUT_ROOT}/${RUN_NAME}/outputs/"
