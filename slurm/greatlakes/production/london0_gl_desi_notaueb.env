# london0_gl_desi_notaueb.env — DESI model, τ-EB OFF, NUM_FOREST_LINES=3
# (the MISMATCHED value: _base.env default, NOT training's 31). Baseline for the
# NF=3 vs NF=31 ΔNHI test. Explicit NF=3 here because london0_gl_v1.env now
# (correctly) sets 31. Pairs with london0_gl_desi_notaueb_nf31.env.
source "$(dirname "${BASH_SOURCE[0]}")/london0_gl_v1.env"
ENABLE_TAU_EB=0
NUM_FOREST_LINES=3
RUN_NAME="gl_desi_notaueb_london0_${RUN_DATE}"
OUTDIR="${GL_OUTPUT_ROOT}/${RUN_NAME}/outputs/"
