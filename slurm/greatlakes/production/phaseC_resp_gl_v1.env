# phaseC_resp_gl_v1.env — Phase-C high-N response-calibration re-inference (GreatLakes).
#
# PURPOSE (docs/PHASEC_CALIB_DESIGN.md, PI rulings 2026-08-06 §4-§5):
#   Re-run the UNMODIFIED production GP on an ANCHORED injection arm generated by
#   injection/gen_phaseC_resp.py (2LPT-0 loa-124 substrate, one absorber per
#   sightline at fixed true-N × z × SNR anchors), so the true→observed response
#   can be measured DIRECTLY at and above the current top anchors.
#
# INFERENCE FAITHFULNESS (same hard discipline as wall1_inject_gl_v1.env):
#   config-only CLONE of loa0_fp_gl_v1.env -> 2lpt0_gl_v1.env — the EXACT
#   production inference chain the deployed response/completeness were measured
#   under. ONLY the data pointers change (MOCKDIR -> the arm tree; QSOCAT -> the
#   arm's restricted pilot_qsocat.fits; OUTDIR under the arm). Every inference
#   parameter is INHERITED UNCHANGED; dla_gp.py / run_bayes_select.py are
#   byte-untouched. This is the ESTIMAND requirement (design §2): the response
#   being measured is the deployed pipeline's response.
#
# Source order: loa0_fp_gl_v1.env -> 2lpt0_gl_v1.env -> london0_gl_v1.env -> _base_gl.env
source "$(dirname "${BASH_SOURCE[0]}")/loa0_fp_gl_v1.env"

# --- ONLY-CHANGES vs loa0_fp_gl_v1.env ---------------------------------------

# 1) The injectable ARM tree (set PHASEC_ARM to the gen_phaseC_resp --out root).
PHASEC_ARM="${PHASEC_ARM:?set PHASEC_ARM=<gen_phaseC_resp --out tree root>}"
MOCKDIR="${PHASEC_ARM}"
# 2) Restricted qsocat = ONLY the injected targets.
QSOCAT="${PHASEC_ARM}/pilot_qsocat.fits"
# 3) Output dir under the arm tree.
OUTDIR="${PHASEC_ARM}/gp_out/"

# 4) Positional healpix window over the arm's files (sized by the launcher).
OUTER_MAX_INDEX="${OUTER_MAX_INDEX:-200}"
OUTER_STEP="${OUTER_STEP:-12}"
OUTER_WINDOW="${OUTER_WINDOW:-10}"

# 5) Drop inherited truth/bal refs (the arm has its own injected_truth_cat.fits;
#    downstream-eval-only, never inference args).
unset TRUTH_CAT
unset BAL_CAT
