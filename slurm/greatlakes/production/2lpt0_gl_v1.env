# 2lpt0_gl_v1.env — V1 production on the 2LPT mock-0 (loa-124), GreatLakes.
# Same validated V1 config as london0_gl_v1.env (2lpt_loa124_nohcd_nobal_wide_m model — NATIVE to this
# 2lpt-loa124 mock — MAX_DLAS=4, SINGLE_ABSORBER_MODEL=1, FILTER_LOW_LIKELIHOOD=1, PW 100k [17.2,22.5],
# MAX_LAMBDA=1250, NUM_FOREST_LINES=31, τ-EB null, +log(N), 12h/128G/window10). Only the mock + release
# differ. Runs the FIXED code (−log_ratio + BAL fixes); BALMASK=false. The clustering-OFF baseline catalog.
source "$(dirname "${BASH_SOURCE[0]}")/london0_gl_v1.env"
MOCKDIR="/nfs/turbo/lsa-cavestru/mfho/DESI/mocks/lyacolore_2lpt/qq_desi_y3/v2.8.5/mock-0/loa-124"
QSOCAT="${MOCKDIR}/zcat.fits"
RELEASE="v2.8.5"
RUN_NAME="gl_prod_2lpt0_v1_${RUN_DATE}"
OUTDIR="${GL_OUTPUT_ROOT}/${RUN_NAME}/outputs/"
# 2lpt loa-124 has 1150 healpix (same as London) → OUTER_MAX_INDEX=1150 inherited.
TRUTH_CAT="${MOCKDIR}/hcd_truth_cat.fits"   # 2lpt truth is hcd_truth_cat (not dla_cat)
BAL_CAT="${MOCKDIR}/bal_cat.fits"
