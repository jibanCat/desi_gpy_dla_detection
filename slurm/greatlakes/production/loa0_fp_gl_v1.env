# loa0_fp_gl_v1.env — forest-FALSE-POSITIVE run on the loa-0 mock (GreatLakes).
#
# PURPOSE (CDDF catalog-HBI, master-plan Phase-2 `Loa0FP`):
#   loa-0 is the HCD-FREE, BYTE-IDENTICAL twin of the production loa-124 mock —
#   same 1,213,217 skewers / same z-range [1.790, 3.808] / same schema, but with
#   NO injected HCDs/DLAs (no hcd_truth_cat, no dla_cat) and NO BAL injection
#   (no bal_cat). Verified 2026-06-15: loa-0 zcat rows == loa-124 zcat rows ==
#   1213217; both have 1150 spectra-16 healpix files.
#   => EVERY GP detection on loa-0 is a forest false positive by construction.
#   Running the *production* GP finder here measures the non-circular forest-FP
#   rate as a function of (N̂, SNR, z) — the principled FP background the
#   catalog-HBI needs for the sub-DLA/LLS tiers (<~20), where the interim
#   purity-mixture FP is in-sample circular.
#
# INFERENCE FAITHFULNESS (hard discipline):
#   This config is a CLONE of 2lpt0_gl_v1.env. It changes ONLY the data pointer
#   (mock + qsocat), the output dir, the SLURM account, and drops the
#   downstream-ONLY truth/dla/bal catalog references (which are never passed to
#   desi-DLAGP.py — verified: they appear in NO --export list and NO python arg
#   in launch_gl.sh / submit_desi_mock_gl.sh; they exist purely for downstream
#   P/C eval, which is meaningless for a truth-free FP mock). EVERY inference
#   parameter (learned model, FILTER_LOW_LIKELIHOOD=1, MAX_DLAS=4,
#   SINGLE_ABSORBER_MODEL=1, NUM_FOREST_LINES=31, MAX_LAMBDA=1250, PW 100k
#   [17.2,22.5] prior, τ-EB null, +log(N), MIN_Z_SEPARATION, K, DLAMBDA, …) is
#   INHERITED UNCHANGED from 2lpt0_gl_v1.env -> london0_gl_v1.env -> _base_gl.env.
#   BALMASK stays false (production default; loa-0 is BAL-free so there is
#   nothing to mask, and the prod run also did not mask — byte-identical path).
#
# Source order (identical chain to the production config, plus our overrides):
#   2lpt0_gl_v1.env -> london0_gl_v1.env -> _base_gl.env -> slurm/configs/_base.env
source "$(dirname "${BASH_SOURCE[0]}")/2lpt0_gl_v1.env"

# --- ONLY-CHANGES vs 2lpt0_gl_v1.env -----------------------------------------

# 1) Point at the loa-0 mock (HCD-free twin) instead of loa-124.
MOCKDIR="/nfs/turbo/lsa-cavestru/mfho/DESI/mocks/lyacolore_2lpt/qq_desi_y3/v2.8.5/mock-0/loa-0"
QSOCAT="${MOCKDIR}/zcat.fits"
# RELEASE (v2.8.5) is unchanged — inherited from 2lpt0_gl_v1.env.

# 2) New output dir on /scratch (does not clobber any production run).
RUN_NAME="gl_loa0_fp_v1_${RUN_DATE}"
OUTDIR="${GL_OUTPUT_ROOT}/${RUN_NAME}/outputs/"

# 3) Drop the truth/dla/bal catalog references — loa-0 has none, and they are
#    downstream-eval-only (NOT consumed by inference). Unset so no stray
#    downstream tool picks up a non-existent ${MOCKDIR}/dla_cat.fits etc.
unset TRUTH_CAT
unset TRUTH_NHI_MIN
unset BAL_CAT

# 4) BAL masking OFF (production default; loa-0 is BAL-free). Explicit for clarity.
BALMASK=false

# 5) SLURM account: cavestru1 (per PI). launch_gl.sh forwards GL_SLURM_ACCOUNT
#    to `sbatch --account`, which overrides the inner script's #SBATCH -A line.
GL_SLURM_ACCOUNT=cavestru1
