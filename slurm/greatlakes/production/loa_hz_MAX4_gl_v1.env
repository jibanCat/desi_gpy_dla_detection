# slurm/greatlakes/production/loa_hz_MAX4_gl_v1.env
# MAX_DLAS=4 high-z production flavour — the MAX4 repair cycle (PI ruling 2026-08-28/29:
# the high-z adopted target is the frozen low-z Paper-1 production configuration of
# loa_main_dark_v1 = MAX_DLAS 4 / SINGLE_ABSORBER_MODEL 1 / FILTER_LOW_LIKELIHOOD 1 /
# PW50k; certified in MAX4 CHECKPOINT 0 §C, 2026-09-01).
#
# Sources the MAX1 GL hz flavour (site plumbing, GPDLA_ZMIN_QSO=4.25 / GPDLA_ZMAX_QSO=7.0,
# the archive route) and overrides ONLY the seven finder-configuration variables that the
# sourced chain fixes at source time (loa_cddf_nersc.env sets MAX_DLAS=1 / FILTER=0 and
# derives the two sample-file paths from NUM_SAMPLES=100000). Nothing else changes.
#
# QMC: 50,000 = the certified low-z value. PI question Q1 (50k vs 100k) is OPEN — if 100k is
# ruled, change NUM_SAMPLES / NUM_DLA_SAMPLES / NUM_SUBDLA_SAMPLES and the two *_SAMPLES_FILE
# names below (one place), and say so in the wave's approval sheet.
#
# The WAVE env that sources this file MUST set OUTDIR (under ROOT_MAX4 — never a MAX1
# directory), EXTERNAL_HPX_LIST and GPDLA_SPECTRA_ARCHIVE (plus QSOCAT / OUTER_MAX_INDEX /
# NERSC_NTASKS). OUTDIR is deliberately left EMPTY here so launch_nersc.sh refuses a direct
# launch of this flavour ("config missing required var: OUTDIR").
#
#   source ".../loa_hz_MAX4_gl_v1.env"
#   QSOCAT=...; OUTDIR=<ROOT_MAX4>/<wave>_outputs; OUTER_MAX_INDEX=<n_hpx-1>; NERSC_NTASKS=8
#   export GPDLA_SPECTRA_ARCHIVE=...; export EXTERNAL_HPX_LIST=...

source "$(dirname "${BASH_SOURCE[0]}")/loa_cddf_hz_gl_v1.env"

# --- the seven MAX4 overrides (certified target; QMC per Q1) -----------------
MAX_DLAS=4
FILTER_LOW_LIKELIHOOD=1
NUM_SAMPLES=50000
NUM_DLA_SAMPLES=50000
NUM_SUBDLA_SAMPLES=50000
DLA_SAMPLES_FILE="${REPO_ROOT}/data/dr12q/processed/pw_samples_a3_172_225_50000.mat"
SUB_DLA_SAMPLES_FILE="${REPO_ROOT}/data/dr12q/processed/subdla_samples_a03_191_200_50000.mat"

RUN_TAG="loa_hz_MAX4_v1"
# left to the wave env (see header); an explicit OUTDIR_OVERRIDE (launch_nersc.sh --outdir) still works
OUTDIR="${OUTDIR_OVERRIDE:-}"
