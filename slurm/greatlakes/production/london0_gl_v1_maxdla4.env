# slurm/greatlakes/production/london0_gl_v1_maxdla4.env
# MAX_DLAS=4 sensitivity test vs the V1 MAX_DLAS=3 production baseline.
# Identical config otherwise — run on the SAME 5k slice (launch with
# --start 0 --end 0 --window 8) so the comparison is apples-to-apples
# (same QSOs, only MAX_DLAS differs). Question: does allowing a 4th DLA
# change P/C or catch more multi-DLA sightlines, or is 3 sufficient?
source "$(dirname "${BASH_SOURCE[0]}")/london0_gl_v1.env"

MAX_DLAS=4
RUN_NAME="gl_maxdla4_london0_v1_${RUN_DATE}"
OUTDIR="${GL_OUTPUT_ROOT}/${RUN_NAME}/outputs/"
