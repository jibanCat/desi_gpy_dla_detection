# london0_gl_desi_notaueb_nf31.env — DESI model, τ-EB OFF, NUM_FOREST_LINES=31
# (MATCHES training: 2lpt model was trained with de_forest_num_lines=31).
# Pairs with london0_gl_desi_notaueb.env (NF=3, the mismatched value) on the
# SAME slice to test whether correcting NUM_FOREST_LINES removes the +0.06 dex
# NHI bias.
source "$(dirname "${BASH_SOURCE[0]}")/london0_gl_v1.env"
ENABLE_TAU_EB=0
NUM_FOREST_LINES=31
RUN_NAME="gl_desi_notaueb_nf31_london0_${RUN_DATE}"
OUTDIR="${GL_OUTPUT_ROOT}/${RUN_NAME}/outputs/"
