# saclay0_gl_v1.env — V1 production on the Saclay mock-0 (juraLy8-124), GreatLakes.
# Cross-mock leg #3: Saclay = a DIFFERENT recipe (in-scope mock; NOT DR3/Matterhorn).
# Identical validated V1 config as london0_gl_v1.env / 2lpt0_gl_v1.env — the
# "production config we decided" (2lpt_loa124_nohcd_nobal_wide_m model, MAX_DLAS=4,
# SINGLE_ABSORBER_MODEL=1, FILTER_LOW_LIKELIHOOD=1, PW 100k [17.2,22.5],
# MAX_LAMBDA=1250, NUM_FOREST_LINES=31, τ-EB null, +log(N), BALMASK=false).
# Only the mock paths, run name, healpix count, and SLURM account differ.
source "$(dirname "${BASH_SOURCE[0]}")/london0_gl_v1.env"

# --- Saclay mock-0 input (juraLy8-124 is the documented Saclay mock-0 subdir) --
MOCKDIR="/nfs/turbo/lsa-cavestru/mfho/DESI/mocks/saclay/qq_desi_y3/v4.7.5/mock-0/juraLy8-124"
QSOCAT="${MOCKDIR}/zcat.fits"
RELEASE="v4.7.5"
RUN_NAME="gl_prod_saclay0_v1_${RUN_DATE}"
OUTDIR="${GL_OUTPUT_ROOT}/${RUN_NAME}/outputs/"

# --- Saclay truth is hcd_truth_cat (like 2lpt; NOT london's dla_cat) ----------
TRUTH_CAT="${MOCKDIR}/hcd_truth_cat.fits"
TRUTH_NHI_MIN=20.3
BAL_CAT="${MOCKDIR}/bal_cat.fits"

# --- Saclay mock-0 juraLy8-124 has 1127 spectra-16 healpix (vs 1150 london/2lpt) -
OUTER_MAX_INDEX=1127
# OUTER_STEP=12 / OUTER_WINDOW=10 inherited from london0_gl_v1.env (5-slice chunks).

# --- PW 50k DLA prior — MIRROR the held-out London-0/2LPT-1 legs exactly --------
# (london0_gl_v1.env defaults to PW 100k; the held-out cross-mock catalogs used
#  PW 50k. SubDLA samples may be unused under SINGLE_ABSORBER_MODEL=1, but set for
#  parity. Both files now staged on GL.)
DLA_SAMPLES_FILE="${GL_DATA_ROOT}/data/dr12q/processed/pw_samples_a3_172_225_50000.mat"
SUB_DLA_SAMPLES_FILE="${GL_DATA_ROOT}/data/dr12q/processed/subdla_samples_a03_191_200_50000.mat"
NUM_DLA_SAMPLES=50000
NUM_SUBDLA_SAMPLES=50000

# --- Run on the cavestru0 allocation (current GL default; was yueyingn0 while cavestru0 was exhausted 6/30) --
GL_SLURM_ACCOUNT=cavestru0
