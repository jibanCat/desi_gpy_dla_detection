# london0_gl_eboss_notaueb.env — LEGACY eBOSS DR16Q model NHI-bias test.
# Same slice/samples/cuts as london0_gl_v1, but the eBOSS .mat model on its
# native grid (k=20, dlambda=0.25, rest 851-1421; DLA window 910.75-1216.75)
# and τ-EB OFF (isolate the raw model continuum). Pairs with
# london0_gl_desi_notaueb.env (DESI model, τ-EB OFF, same slice) to test whether
# the +0.06 dex NHI over-estimate is model-induced (emerged with the DESI model).
source "$(dirname "${BASH_SOURCE[0]}")/london0_gl_v1.env"
LEARNED_FILE="/nfs/turbo/lsa-cavestru/mfho/DESI/pscratch/desi_gpy_dla_detection/data/dr12q/processed/learned_qso_model_lyseries_variance_wmu_boss_dr16q_minus_dr12q_gp_851-1421.mat"
DLAMBDA=0.25
K=20
MIN_LAMBDA=910.75
MAX_LAMBDA=1216.75
NUM_LINES=3
NUM_FOREST_LINES=3
PREV_TAU_0=0.0023
PREV_BETA=3.65
ENABLE_TAU_EB=0
RUN_NAME="gl_eboss_notaueb_london0_${RUN_DATE}"
OUTDIR="${GL_OUTPUT_ROOT}/${RUN_NAME}/outputs/"
