# london0_gl_clustering_on400.env — clustering-prior VALIDATION, ON arm.
# V1 + MIN_Z_SEPARATION=400 + the DLA clustering prior ON (b=2). Compared against
# london0_gl_clustering_off400.env (same floor, prior off) via
# `dla_truth_diagnostics.py --pair-purity` — the GATE: of the close pairs the
# prior newly detects vs the OFF arm, the fraction matching a true truth pair
# must hold (≥0.8) for the prior to be a clean completeness boost rather than
# manufacturing false multiplicity. Run from the clustering_prior worktree.
#
# Use the clustering_prior WORKTREE's code. _base_gl.env sets REPO_ROOT=$GL_REPO
# (default = main tree); override GL_REPO so sbatch --chdir runs the worktree's
# desi-DLAGP.py (which has the prior), not production_533. Data/model/output roots
# are independent /scratch paths, unaffected.
GL_REPO="/home/mfho/clustering_prior_wt"
source "$(dirname "${BASH_SOURCE[0]}")/london0_gl_v1.env"
MIN_Z_SEPARATION=400.0
PAIR_PRIOR_MODE=clustering
DLA_BIAS=2.0
RUN_NAME="gl_clustering_val_on400_london0_${RUN_DATE}"
OUTDIR="${GL_OUTPUT_ROOT}/${RUN_NAME}/outputs/"
