# slurm/greatlakes/production/_base_gl.env
# GreatLakes overlay for the slurm/configs/_base.env recipe.
#
# Source order in a GL flavour config:
#   source "$(dirname "${BASH_SOURCE[0]}")/_base_gl.env"
#
# This file sets *only* the GL-specific path overrides + runtime hooks;
# all scientific knobs (PREV_TAU_0, MIN/MAX_LAMBDA, K, DLAMBDA, …) come
# from the NERSC `slurm/configs/_base.env` which we explicitly source.
# Flavour configs (london0_gl_v1.env, …) layer their own overrides on
# top.
#
# Design intent (2026-05-20):
#   - Additive only. Does not modify `slurm/configs/_base.env` or any
#     NERSC driver. NERSC production runs reference *those* configs and
#     remain untouched.
#   - All data paths land on /nfs/turbo (read-only-ish, mock + prior
#     data) and /scratch/cavestru_root/cavestru0/mfho (writable outputs).
#   - Repo code is loaded from /home/mfho/desi_gpy_dla_detection (the
#     working checkout), NOT from the data root.

# --- GL-specific Python / repo ------------------------------------------------
GL_REPO="${GL_REPO:-/home/mfho/desi_gpy_dla_detection}"
# Catalogs + QMC sample grids now live on cavestru scratch (copied from the
# yueyingn-scratch NERSC transfer 2026-05-21). Keeps inference off /nfs/turbo
# (mid-maintenance) and under our own allocation so it isn't subject to
# another user's scratch purge. Mock SPECTRA are still on Turbo (too big to
# copy) — runs still need Turbo back for those.
GL_DATA_ROOT="${GL_DATA_ROOT:-/scratch/cavestru_root/cavestru0/mfho/DESI/desi_gpy_dla_detection}"
GL_MODEL_ROOT="${GL_MODEL_ROOT:-/scratch/cavestru_root/cavestru0/mfho/phase2_desi}"
GL_OUTPUT_ROOT="${GL_OUTPUT_ROOT:-/scratch/cavestru_root/cavestru0/mfho}"

# --- Pull in NERSC base for all scientific defaults ---------------------------
# Then override path-typed knobs to point at GL filesystems.
_NERSC_BASE="${GL_REPO}/slurm/configs/_base.env"
# shellcheck disable=SC1090
source "$_NERSC_BASE"

# --- Override REPO_ROOT + downstream path knobs (set by _NERSC_BASE) ----------
REPO_ROOT="$GL_REPO"

# Y3 default LEARNED_FILE — flavour configs override for V1 candidate
LEARNED_FILE="${LEARNED_FILE_OVERRIDE:-${GL_DATA_ROOT}/learnlogs/model_epoch_920.h5}"

# Catalogs (DR12Q processed) — live on Turbo
CATALOG_NAME="${GL_DATA_ROOT}/data/dr12q/processed/catalog.mat"
LOS_CATALOG="${GL_DATA_ROOT}/data/dla_catalogs/dr9q_concordance/processed/los_catalog"
DLA_CATALOG="${GL_DATA_ROOT}/data/dla_catalogs/dr9q_concordance/processed/dla_catalog"

# DLA / sub-DLA sample grids — flavour configs override for LLS variants
DLA_SAMPLES_FILE="${DLA_SAMPLES_FILE_OVERRIDE:-${GL_DATA_ROOT}/data/dr12q/processed/dla_samples_a03.mat}"
SUB_DLA_SAMPLES_FILE="${SUB_DLA_SAMPLES_FILE_OVERRIDE:-${GL_DATA_ROOT}/data/dr12q/processed/subdla_samples.mat}"

# --- GL SLURM scheduler defaults ----------------------------------------------
GL_SLURM_ACCOUNT="${GL_SLURM_ACCOUNT:-cavestru0}"
GL_SLURM_PARTITION="${GL_SLURM_PARTITION:-standard}"
GL_SLURM_TIME="${GL_SLURM_TIME:-08:00:00}"
GL_SLURM_CPUS="${GL_SLURM_CPUS:-32}"
# Per-job memory. Default mirrors submit_desi_mock_gl.sh's #SBATCH --mem=64G;
# launch_gl.sh forwards this so a flavour can raise it (London-0 V1 OOM'd 9 steps
# at 64G with N=2×W=16 at 100k samples → bumped to 128G in london0_gl_v1.env).
GL_SLURM_MEM="${GL_SLURM_MEM:-64G}"
GL_SLURM_MEM="${GL_SLURM_MEM:-64G}"

# --- Conda env + libcerf runtime ----------------------------------------------
GL_CONDA_SETUP="${GL_CONDA_SETUP:-/sw/pkgs/arc/mamba/py3.11/etc/profile.d/conda.sh}"
GL_CONDA_ENV="${GL_CONDA_ENV:-gpdla}"
GL_LIBCERF_PATH="${GL_LIBCERF_PATH:-$HOME/.local/usr/local/lib64}"

# --- Validate writable-output root --------------------------------------------
# /scratch on GreatLakes is a symlink farm onto /gpfs/accounts/...; readlink
# canonicalises, so include both forms.
GL_ALLOWED_OUTPUT_PREFIXES=(
    "/scratch/cavestru_root/cavestru0/mfho/"
    "/gpfs/accounts/cavestru_root/cavestru0/mfho/"
    "/nfs/turbo/lsa-cavestru/mfho/"
)
