# london0_gl_clustering_off400.env — clustering-prior VALIDATION, OFF arm.
# Identical to V1 but MIN_Z_SEPARATION lowered to 400 (≈Δv 108 km/s at z~2.7,
# admits the strongly-clustered <500 km/s truth pairs) and the clustering prior
# OFF. This is the matched control for london0_gl_clustering_on400.env — same
# floor, prior off — so pair_purity(ON, OFF) isolates the PRIOR's effect on
# close-pair detection (not the floor's). Run from the clustering_prior worktree.
#
# Use the clustering_prior WORKTREE's code. _base_gl.env sets REPO_ROOT=$GL_REPO
# (default = main tree); override GL_REPO so sbatch --chdir runs the worktree's
# desi-DLAGP.py (which has the prior), not production_533. Data/model/output roots
# are independent /scratch paths, unaffected.
GL_REPO="/home/mfho/clustering_prior_wt"
source "$(dirname "${BASH_SOURCE[0]}")/london0_gl_v1.env"
MIN_Z_SEPARATION=400.0
PAIR_PRIOR_MODE=off
RUN_NAME="gl_clustering_val_off400_london0_${RUN_DATE}"
OUTDIR="${GL_OUTPUT_ROOT}/${RUN_NAME}/outputs/"
