# Saclay mock-0, multi-DLA mode. v4.7.5/juraLy8-124 (read-only on desicollab).
source "$(dirname "${BASH_SOURCE[0]}")/_base.env"

MODE="mock"
MOCKDIR="/global/cfs/cdirs/desicollab/mocks/lya_forest/develop/saclay/qq_desi_y3/v4.7.5/mock-0/juraLy8-124"
QSOCAT="${MOCKDIR}/zcat.fits"
OUTDIR="${OUTDIR:-/pscratch/sd/j/jibancat/desi-mock-saclay-0-gpdla-${RUN_DATE:-$(date +%Y%m%d)}-y3-learned-epoch920/}"
RELEASE="v4.7.5"

MAX_DLAS=3
SINGLE_ABSORBER_MODEL=0
FILTER_LOW_LIKELIHOOD=1

# spectra-16 file count for Saclay mock-0 = 1127
OUTER_MAX_INDEX=1127
OUTER_STEP=64
OUTER_WINDOW=62
