# slurm/configs/_base.env — shared defaults sourced by every flavour
#
# A flavour config under slurm/configs/<flavour>.env should:
#   1. `source "$(dirname "${BASH_SOURCE[0]}")/_base.env"`
#   2. set MODE (loa|mock), the flavour-specific paths (QSOCAT, MOCKDIR, OUTDIR,
#      LEARNED_FILE, DLA_SAMPLES_FILE, SUB_DLA_SAMPLES_FILE),
#   3. override absorber-mode knobs (MAX_DLAS, SINGLE_ABSORBER_MODEL, …) if needed,
#   4. set OUTER_MAX_INDEX + OUTER_STEP for the outer launcher loop.
#
# Inner scripts honour these env vars; see slurm/submit_desi_loa.sh,
# slurm/submit_desi_mock.sh.

# --- Repo / data root ----------------------------------------------------------
REPO_ROOT="${REPO_ROOT:-/pscratch/sd/j/jibancat/desi_gpy_dla_detection}"

# --- Y3 GP model (the published production model) -----------------------------
LEARNED_FILE="${LEARNED_FILE:-${REPO_ROOT}/learnlogs/model_epoch_920.h5}"
CATALOG_NAME="${CATALOG_NAME:-${REPO_ROOT}/data/dr12q/processed/catalog.mat}"
LOS_CATALOG="${LOS_CATALOG:-${REPO_ROOT}/data/dla_catalogs/dr9q_concordance/processed/los_catalog}"
DLA_CATALOG="${DLA_CATALOG:-${REPO_ROOT}/data/dla_catalogs/dr9q_concordance/processed/dla_catalog}"

# --- Mean-flux prior (Turner+2024) --------------------------------------------
PREV_TAU_0="${PREV_TAU_0:-0.00246}"
PREV_BETA="${PREV_BETA:-3.62}"

# --- Wavelength + GP grid (Y3 production) -------------------------------------
LOADING_MIN_LAMBDA="${LOADING_MIN_LAMBDA:-910}"
LOADING_MAX_LAMBDA="${LOADING_MAX_LAMBDA:-1550}"
NORMALIZATION_MIN_LAMBDA="${NORMALIZATION_MIN_LAMBDA:-1425}"
NORMALIZATION_MAX_LAMBDA="${NORMALIZATION_MAX_LAMBDA:-1475}"
MIN_LAMBDA="${MIN_LAMBDA:-911.75}"
MAX_LAMBDA="${MAX_LAMBDA:-1216.75}"
DLAMBDA="${DLAMBDA:-0.15}"
K="${K:-30}"
NUM_FOREST_LINES="${NUM_FOREST_LINES:-3}"
NUM_LINES="${NUM_LINES:-3}"
MIN_Z_SEPARATION="${MIN_Z_SEPARATION:-3000.0}"
MAX_Z_CUT="${MAX_Z_CUT:-3000.0}"
MIN_Z_CUT="${MIN_Z_CUT:-3000.0}"
MAX_NOISE_VARIANCE="${MAX_NOISE_VARIANCE:-9}"

# --- Multi-DLA mode defaults (override in LLS configs) ------------------------
MAX_DLAS="${MAX_DLAS:-3}"
SINGLE_ABSORBER_MODEL="${SINGLE_ABSORBER_MODEL:-0}"
FILTER_LOW_LIKELIHOOD="${FILTER_LOW_LIKELIHOOD:-1}"

# --- QMC sample counts --------------------------------------------------------
# NUM_DLA_SAMPLES must match the row-count of DLA_SAMPLES_FILE — the kept .mat
# files on /pscratch are 10k (dla_samples_a03.mat, subdla_samples.mat) and 50k
# (pw_samples_a3_*_220_50000.mat). LLS configs override these for the 50k pair.
NUM_DLA_SAMPLES="${NUM_DLA_SAMPLES:-10000}"
NUM_SUBDLA_SAMPLES="${NUM_SUBDLA_SAMPLES:-10000}"
DLA_SAMPLES_FILE="${DLA_SAMPLES_FILE:-${REPO_ROOT}/data/dr12q/processed/dla_samples_a03.mat}"
SUB_DLA_SAMPLES_FILE="${SUB_DLA_SAMPLES_FILE:-${REPO_ROOT}/data/dr12q/processed/subdla_samples.mat}"

# --- Parallelism / batching ---------------------------------------------------
MAX_WORKERS="${MAX_WORKERS:-8}"
BATCH_SIZE="${BATCH_SIZE:-1250}"
PLOT_FIGURES="${PLOT_FIGURES:-0}"

# --- BAL treatment ------------------------------------------------------------
# Production runs include BAL QSOs without masking. Set to "true" to mask.
BALMASK="${BALMASK:-false}"

# --- DESI survey/program/release (matter only for real LOA; mocks ignore) ----
RELEASE="${RELEASE:-v5.9.5}"
PROGRAM="${PROGRAM:-dark}"
SURVEY="${SURVEY:-main}"
