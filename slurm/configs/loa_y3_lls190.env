# Real DESI LOA, LLS-mode single-absorber, NHI floor 19.0.
source "$(dirname "${BASH_SOURCE[0]}")/_base.env"

MODE="loa"
QSOCAT="/global/cfs/cdirs/desi/science/lya/y3/loa/catalogs/QSO_cat_loa_main_dark_healpix_v2-altbal-20241115.fits"
OUTDIR="${OUTDIR:-/pscratch/sd/j/jibancat/desi-loa-gpdla-${RUN_DATE:-$(date +%Y%m%d)}-y3-learned-epoch920-lls_run-nhi190/}"

MAX_DLAS=1
SINGLE_ABSORBER_MODEL=1
FILTER_LOW_LIKELIHOOD=0
NUM_DLA_SAMPLES=50000
NUM_SUBDLA_SAMPLES=100000
BATCH_SIZE=6250
DLA_SAMPLES_FILE="${REPO_ROOT}/data/dr12q/processed/pw_samples_a3_190_220_50000.mat"
SUB_DLA_SAMPLES_FILE="${REPO_ROOT}/data/dr12q/processed/subdla_samples_a03_191_200_100000.mat"

OUTER_MAX_INDEX=16519
OUTER_STEP=1664
OUTER_WINDOW=1612
