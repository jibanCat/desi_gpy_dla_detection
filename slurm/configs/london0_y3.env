# London mock-0, multi-DLA mode. v5.9.5/jura-124 (read-only on CFS).
source "$(dirname "${BASH_SOURCE[0]}")/_base.env"

MODE="mock"
MOCKDIR="/global/cfs/projectdirs/desi/mocks/lya_forest/london/qq_desi_y3/v5.9.5/mock-0/jura-124"
QSOCAT="${MOCKDIR}/zcat.fits"
OUTDIR="${OUTDIR:-/pscratch/sd/j/jibancat/desi-mock-gpdla-${RUN_DATE:-$(date +%Y%m%d)}-y3-learned-epoch920/}"
RELEASE="v5.9.5"

MAX_DLAS="${MAX_DLAS:-3}"
SINGLE_ABSORBER_MODEL="${SINGLE_ABSORBER_MODEL:-0}"
FILTER_LOW_LIKELIHOOD="${FILTER_LOW_LIKELIHOOD:-1}"

# spectra-16 file count for London mock-0 = 1150
OUTER_MAX_INDEX=1150
OUTER_STEP=64
OUTER_WINDOW=62      # 31 × 2 — chunk size INSIDE one sbatch
