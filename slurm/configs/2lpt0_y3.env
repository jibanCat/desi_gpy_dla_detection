# 2LPT mock-0 (v2.8.5/loa-124), multi-DLA mode. New flavour — no historic run.
source "$(dirname "${BASH_SOURCE[0]}")/_base.env"

MODE="mock"
MOCKDIR="/global/cfs/cdirs/desicollab/mocks/lya_forest/develop/lyacolore_2lpt/qq_desi_y3/v2.8.5/mock-0/loa-124"
QSOCAT="${MOCKDIR}/zcat.fits"
OUTDIR="${OUTDIR:-/pscratch/sd/j/jibancat/desi-mock-2lpt-0-gpdla-${RUN_DATE:-$(date +%Y%m%d)}-y3-learned-epoch920/}"
RELEASE="v2.8.5"

MAX_DLAS=3
SINGLE_ABSORBER_MODEL=0
FILTER_LOW_LIKELIHOOD=1

# spectra-16 file count for 2LPT mock-0 v2.8.5 = 1150
OUTER_MAX_INDEX=1150
OUTER_STEP=64
OUTER_WINDOW=62
