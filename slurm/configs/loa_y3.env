# Real DESI LOA, multi-DLA mode (the standard headline catalog).
# Output mirrors the historic desi-loa-gpdla-20250912-desi-learned/ run.
source "$(dirname "${BASH_SOURCE[0]}")/_base.env"

MODE="loa"
QSOCAT="/global/cfs/cdirs/desi/science/lya/y3/loa/catalogs/QSO_cat_loa_main_dark_healpix_v2-altbal-20241115.fits"

# Allowed write area (/pscratch). Append a date suffix when re-running.
OUTDIR="${OUTDIR:-/pscratch/sd/j/jibancat/desi-loa-gpdla-${RUN_DATE:-$(date +%Y%m%d)}-y3-learned-epoch920/}"

# Multi-DLA mode (default from _base.env). Explicit for clarity:
MAX_DLAS=3
SINGLE_ABSORBER_MODEL=0
FILTER_LOW_LIKELIHOOD=1

# Outer launcher loop. LOA covers 16519 healpix indices; submit_desi_loa.sh
# splits each sbatch job into 32 srun tasks × 52 healpix = 1664 per job.
OUTER_MAX_INDEX=16519
OUTER_STEP=1664      # 32 × 52
OUTER_WINDOW=1612    # 31 × 52 — chunk size INSIDE one sbatch
