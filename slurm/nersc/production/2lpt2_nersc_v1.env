# slurm/nersc/production/2lpt2_nersc_v1.env
# NERSC 2LPT mock-2, V1 production config — mirror of 2lpt1_nersc_v1.env for the
# mock-2 realization. Science knobs identical (sourced via london0); only the mock
# realization (paths + truth catalog) changes. 2LPT uses hcd_truth_cat.fits.

RUN_DATE="${RUN_DATE:-$(date +%Y%m%d)}"
RUN_NAME="${RUN_NAME:-nersc_prod_2lpt2_v1_${RUN_DATE}}"

source "$(dirname "${BASH_SOURCE[0]}")/london0_nersc_v1.env"

# --- 2LPT mock-2 spectra (NERSC CFS; v2.8.5, loa-124 subdir) -----------------
MOCKDIR="/global/cfs/projectdirs/desi/mocks/lya_forest/develop/lyacolore_2lpt/qq_desi_y3/v2.8.5/mock-2/loa-124"
QSOCAT="${MOCKDIR}/zcat.fits"
RELEASE="v2.8.5"

# --- 2LPT truth catalog (hcd_truth_cat.fits) ---------------------------------
TRUTH_CAT="${MOCKDIR}/hcd_truth_cat.fits"
BAL_CAT="${MOCKDIR}/bal_cat.fits"
