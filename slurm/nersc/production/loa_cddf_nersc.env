# slurm/nersc/production/loa_cddf_nersc.env
# NERSC real LOA dense-1-DLA CDDF run (Pathway-A Bayesian CDDF input).
# = loa_nersc_v1.env but FILTER_LOW_LIKELIHOOD=0 and MAX_DLAS=1: computes the full
# QMC bag for the 1-DLA model only (dense, 0% NaN), dropping the multi-DLA cascade.
# Mirror of the GL 2lpt0_gl_v1_filteroff_maxdla1.env, for LOA, at PW100k.
#
# Cost driver is FILTER=0 (no early-stop → full QMC on every spectrum, incl. the
# ~90% no-DLA majority), NOT nfl. Measured per-spec (pilot 54182776, real LOA):
# 7.75 wall-s/spec at PW50k, 13.07 at PW100k. Full LOA (~946k z>2 specs) at PW100k
# = ~107 nh ideal-pack. The static equal-count task split leaves a ~30% idle tail
# (~140 nh); the spec-weighted split (LOA_BALANCE_COUNTS, Option B, ON by default
# below) cuts it to ~5-9% → ~115 nh. Window sizing at 13.07 s/spec: ~768 hpx/job
# → ~6.3h heaviest task under an 8h walltime.

RUN_DATE="${RUN_DATE:-$(date +%Y%m%d)}"
# Default CDDF PW = 100k (denser integral; user's choice). Override NUM_SAMPLES to change.
NUM_SAMPLES="${NUM_SAMPLES:-100000}"
RUN_NAME="${RUN_NAME:-nersc_cddf_loa_v1_filteroff_maxdla1_${RUN_DATE}}"

source "$(dirname "${BASH_SOURCE[0]}")/loa_nersc_v1.env"

# --- CDDF overrides ----------------------------------------------------------
FILTER_LOW_LIKELIHOOD=0
MAX_DLAS=1
# Option B load-balancing ON by default (CDDF is uniform per-spec, so the
# equal-count split's idle tail is pure waste). Set LOA_BALANCE_COUNTS= (empty)
# to disable -- note the `-` (not `:-`): an explicit empty value stays empty and
# turns B off, only an UNSET var falls through to the default table. Regenerate
# with tools/loa_hpx_spec_counts.py if the QSO catalog changes. REPO_ROOT is set
# by _base_nersc.env (sourced above).
LOA_BALANCE_COUNTS="${LOA_BALANCE_COUNTS-${REPO_ROOT}/slurm/nersc/production/loa_hpx_spec_counts.txt}"
OUTDIR="${OUTDIR_OVERRIDE:-${NERSC_OUTPUT_ROOT}/${RUN_NAME}/outputs/}"
