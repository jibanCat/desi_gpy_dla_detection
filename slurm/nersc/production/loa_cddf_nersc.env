# slurm/nersc/production/loa_cddf_nersc.env
# NERSC real LOA dense-1-DLA CDDF run (Pathway-A Bayesian CDDF input).
# = loa_nersc_v1.env but FILTER_LOW_LIKELIHOOD=0 and MAX_DLAS=1: computes the full
# QMC bag for the 1-DLA model only (dense, 0% NaN), dropping the multi-DLA cascade.
# Mirror of the GL 2lpt0_gl_v1_filteroff_maxdla1.env, for LOA, at PW100k.
#
# Cost driver is FILTER=0 (no early-stop → full QMC on every spectrum, incl. the
# ~90% no-DLA majority), NOT nfl. Measured 2026-06-02 on real LOA: 62 cpu-s/spec
# at PW50k (~63.5 nh); PW100k ≈ ~115-130 nh (extrapolated ×1.8-2, not directly run).
# NOTE: CDDF is uniform per-spectrum → load-balancing gives NO speedup here.

RUN_DATE="${RUN_DATE:-$(date +%Y%m%d)}"
# Default CDDF PW = 100k (denser integral; user's choice). Override NUM_SAMPLES to change.
NUM_SAMPLES="${NUM_SAMPLES:-100000}"
RUN_NAME="${RUN_NAME:-nersc_cddf_loa_v1_filteroff_maxdla1_${RUN_DATE}}"

source "$(dirname "${BASH_SOURCE[0]}")/loa_nersc_v1.env"

# --- CDDF overrides ----------------------------------------------------------
FILTER_LOW_LIKELIHOOD=0
MAX_DLAS=1
OUTDIR="${OUTDIR_OVERRIDE:-${NERSC_OUTPUT_ROOT}/${RUN_NAME}/outputs/}"
