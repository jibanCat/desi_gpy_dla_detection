# slurm/nersc/production/matterhorn_nersc_v1.env
# NERSC real DESI matterhorn QSO catalog run, V1 production config. Same FILTER-on
# multi-DLA (single-absorber) pipeline as the LOA V1 deliverable, repointed at the
# matterhorn release. There is NO mock truth catalog (real data -> P/C is not
# measurable; validate completeness via the mock runs).
#
# Science knobs are BYTE-IDENTICAL to loa_nersc_v1.env: this file sources that
# config and then OVERRIDES only the release, the data inputs, and the
# load-balancing table. Everything that affects inference results
# (NUM_SAMPLES=50000, FILTER_LOW_LIKELIHOOD=1, MAX_DLAS=4, SINGLE_ABSORBER_MODEL=1,
# BALMASK=false, the PW prior + sample grids, MAX_LAMBDA, tau-EB, early-stop, ...)
# flows through unchanged from loa_nersc_v1.env -> _base_nersc.env -> _base.env.
#
# matterhorn-specific differences from LOA:
#   * RELEASE=matterhorn -- desi-DLAGP healpix mode reads spectra from the
#     matterhorn redux tree (release/survey/program below), not the loa tree.
#   * QSOCAT is the matterhorn main-dark healpix catalog (altbal variant; as with
#     LOA the BAL columns are NOT loaded -- BALMASK stays false, no masking).
#   * PIXEL_COL=UNIQPIX -- the matterhorn catalog indexes healpix by the UNIQPIX
#     column, not HPXPIXEL. The submit/launch default (--pixel_col HPXPIXEL) is
#     UNCHANGED and still drives the byte-identical loa/mock behavior; only this
#     matterhorn flavour overrides it to UNIQPIX. (parity contract)
#   * OUTER_MAX_INDEX=17912 -- number of z>2 healpix indices in the matterhorn
#     catalog (== data lines in matterhorn_uniqpix_qso_counts.txt). The outer loop
#     walks [0, 17912) in --window steps; the inner script splits each window
#     across NTASKS tasks (use a large --window for load balancing, as for LOA).
#   * LOA_BALANCE_COUNTS points at the matterhorn per-UNIQPIX spec-count table so
#     Option B spec-weighted task boundaries match the matterhorn pixel ordering.
#     This table holds per-healpix QSO counts, so it is kept on CFS (NOT in git).
#     Regenerate with tools/loa_hpx_spec_counts.py if the QSO catalog changes, or
#     override LOA_BALANCE_COUNTS to point at your own copy.

RUN_DATE="${RUN_DATE:-$(date +%Y%m%d)}"
RUN_NAME="${RUN_NAME:-nersc_prod_matterhorn_v1_${RUN_DATE}}"

source "$(dirname "${BASH_SOURCE[0]}")/loa_nersc_v1.env"

# --- matterhorn overrides (science knobs untouched; see header) --------------
RELEASE=matterhorn
QSOCAT="/pscratch/sd/j/jibancat/QSO-Catalogs/QSO_cat_matterhorn_main_dark_healpix_v0-altbal.fits"
PIXEL_COL=UNIQPIX
OUTER_MAX_INDEX=17912

# Spec-weighted (Option B) load-balancing table keyed by the matterhorn UNIQPIX
# ordering. Kept on CFS (not committed) because it holds per-healpix QSO counts;
# regenerate with `tools/loa_hpx_spec_counts.py --pixel-col UNIQPIX`, or override
# LOA_BALANCE_COUNTS in the environment to point at your own copy.
LOA_BALANCE_COUNTS="${LOA_BALANCE_COUNTS:-/global/cfs/cdirs/desicollab/users/jibancat/DLA/matterhorn/matterhorn_main_dark_v1/matterhorn_uniqpix_qso_counts.txt}"

# Output root tracks the matterhorn RUN_NAME (NERSC_OUTPUT_ROOT from _base_nersc.env).
OUTDIR="${OUTDIR:-${NERSC_OUTPUT_ROOT}/${RUN_NAME}/outputs/}"
