# slurm/nersc/production/2lpt1_nersc_v1.env
# NERSC 2LPT mock-1, V1 production config — mirror of 2lpt0_gl_v1.env but for
# the mock-1 realization (the user's priority alongside London-0).
#
# Science knobs identical to london0_nersc_v1.env (sourced below); only the mock
# realization (paths + truth catalog) changes. 2LPT-1 uses hcd_truth_cat.fits
# (London uses dla_cat.fits).
#
# NB: RUN_NAME is set BEFORE sourcing london0 so london0's OUTDIR derivation
# (OUTDIR="${OUTDIR:-.../${RUN_NAME}/outputs/}") picks up the 2LPT-1 name. The
# mock paths/RELEASE/truth are overridden AFTER the source (london0 hardcodes them).

RUN_DATE="${RUN_DATE:-$(date +%Y%m%d)}"
RUN_NAME="${RUN_NAME:-nersc_prod_2lpt1_v1_${RUN_DATE}}"

source "$(dirname "${BASH_SOURCE[0]}")/london0_nersc_v1.env"

# --- 2LPT mock-1 spectra (NERSC CFS; v2.8.5, loa-124 subdir) -----------------
MOCKDIR="/global/cfs/projectdirs/desi/mocks/lya_forest/develop/lyacolore_2lpt/qq_desi_y3/v2.8.5/mock-1/loa-124"
QSOCAT="${MOCKDIR}/zcat.fits"
RELEASE="v2.8.5"

# --- 2LPT truth catalog (hcd_truth_cat.fits, not dla_cat.fits) ---------------
TRUTH_CAT="${MOCKDIR}/hcd_truth_cat.fits"
BAL_CAT="${MOCKDIR}/bal_cat.fits"
