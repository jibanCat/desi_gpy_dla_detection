# slurm/nersc/production/_base_nersc.env
# NERSC (Perlmutter) overlay for the slurm/configs/_base.env recipe — the mirror
# of slurm/greatlakes/production/_base_gl.env, but pointed back at NERSC.
#
# Source order in a NERSC flavour config:
#   source "$(dirname "${BASH_SOURCE[0]}")/_base_nersc.env"
#
# Sets ONLY plumbing — paths, scheduler, env activation, writable-prefix
# allowlist, and the per-cluster parallelism packing. ALL scientific knobs come
# from slurm/configs/_base.env (sourced below) and the flavour overrides; this
# file touches none of them. (Mirrors the GL overlay's "additive only" intent.)
#
# Note: on NERSC the in-repo slurm/configs/_base.env already points REPO_ROOT +
# the catalog/sample paths at /pscratch, so this overlay is much thinner than
# _base_gl.env (which had to redirect everything away from the NERSC defaults).

# --- Repo root + NERSC scientific defaults ------------------------------------
REPO_ROOT="${REPO_ROOT:-/pscratch/sd/j/jibancat/desi_gpy_dla_detection}"
_NERSC_BASE="${REPO_ROOT}/slurm/configs/_base.env"
# shellcheck disable=SC1090
source "$_NERSC_BASE"

# --- Output root (writable scratch) -------------------------------------------
# $PSCRATCH is purged after ~8 weeks of inactivity — move keepers to a CFS
# project area (docs/nersc_write_permissions.md) before they are culled.
NERSC_OUTPUT_ROOT="${NERSC_OUTPUT_ROOT:-/pscratch/sd/j/jibancat}"

# --- V1 trained GP model (durable CFS area, group-readable) -------------------
NERSC_MODEL_ROOT="${NERSC_MODEL_ROOT:-/global/cfs/cdirs/desicollab/users/jibancat/DLA/learned/phase2_desi}"

# --- NERSC SLURM scheduler (CPU jobs) -----------------------------------------
# GPU jobs would need -A desi_g + gpu_* QOS (docs/nersc_write_permissions.md); not used here.
NERSC_SLURM_ACCOUNT="${NERSC_SLURM_ACCOUNT:-desi}"
NERSC_SLURM_QOS="${NERSC_SLURM_QOS:-regular}"
NERSC_SLURM_CONSTRAINT="${NERSC_SLURM_CONSTRAINT:-cpu}"
NERSC_SLURM_TIME="${NERSC_SLURM_TIME:-08:00:00}"

# --- Parallelism packing (Perlmutter-specific; measured, not ported) ----------
# Parallelism sweep 2026-06-01 (slurm/nersc/production/parallelism_sweep_nersc.sh):
# N=32 srun tasks × W=8 inner workers = 256 logical cores/node was the throughput
# optimum at 301 spec/min/node — BEAT GL's N=2×W=16 packing (which scaled to
# N16×W16 = 258 here, ~14% slower) and N64×W4 (198) / N8×W32 (165). GL's 36-core
# Intel optimum (W=16) does NOT transfer to Perlmutter's 128-core/256-thread Milan.
# MAX_WORKERS overrides the GL flavour's W=16 — this is per-cluster plumbing, NOT
# a science change (parallelism does not affect inference results).
NERSC_NTASKS="${NERSC_NTASKS:-32}"
MAX_WORKERS="${MAX_WORKERS:-8}"

# --- Env activation -----------------------------------------------------------
# DESI software stack provides numpy/scipy/astropy/fitsio/desiutil; gpy_dla_detection
# rides on top and _voigt.so is prebuilt — no conda, no libcerf LD_LIBRARY_PATH
# (unlike GL). NB: desi_environment.sh references unbound vars (DESI_ROOT), so any
# caller using `set -u` must wrap the source in set +u / set -u.
NERSC_ENV_SETUP="${NERSC_ENV_SETUP:-source /global/cfs/cdirs/desi/software/desi_environment.sh main}"

# --- Writable-output allowlist (docs/nersc_write_permissions.md) --------------
NERSC_ALLOWED_OUTPUT_PREFIXES=(
    "/pscratch/sd/j/jibancat/"
    "/global/cfs/cdirs/desicollab/users/jibancat/"
)
