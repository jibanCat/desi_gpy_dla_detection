# High-z incremental LOA CDDF production — the z_qso > 4.25 sightlines
# omitted from the 2026-06 productions (PI ruling 2026-08-12).
#
# IDENTICAL finder configuration to the frozen CDDF run (loa_cddf_nersc.env,
# BASELINE.env of loa_cddf_main_dark_v1, CODE_COMMIT bc6c4cb): the ONLY
# scientific difference is the input-population window below, which selects
# the exact complement of the historical run (Z in (2.0, 4.25] there; here
# (4.25, 7.0]). Disjoint z partition => no duplicate QSOs, no duplicate
# absorbers, no touched lower-z rows, by construction.
#
# PILOT: set EXTERNAL_HPX_LIST to the pilot healpix list (from
# tools/hz_pilot_select.py) to run the ~40-target pilot only. Leave it
# unset for the full incremental run (PI approval required first).
#
# The GP model runs beyond its z_qso <= 4.25 TRAINING domain here; that is
# the point of the pilot. No prior/model/search/scoring setting changes.

source "$(dirname "${BASH_SOURCE[0]}")/loa_cddf_nersc.env"

# input-population window (consumed by constants.py; historical defaults
# are 2.0/4.25 — these two lines ARE the incremental-run selection)
export GPDLA_ZMIN_QSO=4.25
export GPDLA_ZMAX_QSO=7.0

OUTDIR="${NERSC_OUTPUT_ROOT}/nersc_cddf_loa_hz_v1_$(date +%Y%m%d)/outputs"
RUN_TAG="loa_cddf_hz_v1"
