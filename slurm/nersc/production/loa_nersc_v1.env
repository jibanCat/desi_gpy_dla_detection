# slurm/nersc/production/loa_nersc_v1.env
# NERSC real DESI Y3 LOA catalog run, V1 production config — the headline NERSC
# deliverable (full real-spectra access GL lacked). FILTER-on multi-DLA catalog.
#
# Science knobs BYTE-IDENTICAL to the mock V1 config (london0_nersc_v1.env); only
# MODE=loa + the real-LOA data paths + healpix-mode driving differ. There is NO
# mock truth catalog (real data → P/C is not measurable; validate via the mock runs).
#
# Measured cost (2026-06-02, real LOA, N32×W8, load-balanced): 2.657 s/spec,
# ~21.7 nh for 942,946 QSOs at PW50k.

source "$(dirname "${BASH_SOURCE[0]}")/_base_nersc.env"

MODE="loa"
RUN_DATE="${RUN_DATE:-$(date +%Y%m%d)}"
RUN_NAME="${RUN_NAME:-nersc_prod_loa_v1_${RUN_DATE}}"

# --- Real DESI Y3 LOA inputs -------------------------------------------------
# QSO catalog: Y3 LOA main-dark healpix catalog (altbal). Spectra are read by
# desi-DLAGP healpix mode from $DESI_ROOT/spectro/redux/loa/healpix/main/dark
# via release/survey/program below.
QSOCAT="/global/cfs/cdirs/desi/science/lya/y3/loa/catalogs/QSO_cat_loa_main_dark_healpix_v2-altbal-20241115.fits"
RELEASE="loa"
PROGRAM="dark"
SURVEY="main"

OUTDIR="${OUTDIR:-${NERSC_OUTPUT_ROOT}/${RUN_NAME}/outputs/}"

# --- V1 candidate model (desicollab CFS) -------------------------------------
LEARNED_FILE="${NERSC_MODEL_ROOT}/2lpt_loa124_nohcd_nobal_wide_m/phase2_result.h5"

# --- Science knobs (V1, byte-identical to the mock catalog config) -----------
NUM_FOREST_LINES=31
MAX_DLAS=4
SINGLE_ABSORBER_MODEL=1
FILTER_LOW_LIKELIHOOD=1
ENABLE_TAU_EB=1
TAU_EB_OBJECTIVE=null
EARLY_STOP_MODE=baseline
MAX_LAMBDA=1250
BALMASK=false

# --- PW prior (NHI 17.2-22.5). NUM_SAMPLES picks the grid + counts. -----------
NUM_SAMPLES="${NUM_SAMPLES:-50000}"
NUM_DLA_SAMPLES="$NUM_SAMPLES"
NUM_SUBDLA_SAMPLES="$NUM_SAMPLES"
DLA_SAMPLES_FILE="${REPO_ROOT}/data/dr12q/processed/pw_samples_a3_172_225_${NUM_SAMPLES}.mat"
SUB_DLA_SAMPLES_FILE="${REPO_ROOT}/data/dr12q/processed/subdla_samples_a03_191_200_${NUM_SAMPLES}.mat"

# --- Parallelism (Perlmutter optimum) ----------------------------------------
MAX_WORKERS=8
BATCH_SIZE=1250

# --- Outer-loop range = HEALPIX indices (LOA has 16519 z>2 healpix) ----------
# launch_nersc.sh loops [0, OUTER_MAX_INDEX) in --window steps; for MODE=loa the
# inner script (submit_desi_loa_nersc.sh) interprets each window as an HPX range
# split across NTASKS tasks. Use a LARGE --window (~12-20 hpx/task) for load
# balancing (the measured 722 spec/min figure; 1-hpx/task drops to ~423).
OUTER_MAX_INDEX=16519
