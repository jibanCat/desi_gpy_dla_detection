# slurm/nersc/production/london0_nersc_v1.env
# NERSC London-0 mock, V1 production config — mirror of london0_gl_v1.env.
#
# Science knobs are BYTE-IDENTICAL to the GL V1 config (single-absorber 2-way,
# MAX_DLAS=4, FILTER=1, NUM_FOREST_LINES=31, MAX_LAMBDA=1250, τ-EB null,
# PW prior NHI [17.2,22.5], BAL included). ONLY plumbing differs:
#   - data paths point at the NERSC mock + CFS model;
#   - parallelism W=8 / N=32 (the measured Perlmutter optimum, vs GL's W=16);
#   - NUM_SAMPLES is parameterized so the same file runs at any PW
#     (10000/30000/50000/100000) by overriding NUM_SAMPLES at launch.
#
# GL reference P/C to reproduce on the 5k validation slice (PW100k):
#   London-0 5k PW-100k → P 0.818 / C 0.904  (kickoff Step 4 cross-check).

source "$(dirname "${BASH_SOURCE[0]}")/_base_nersc.env"

MODE="mock"
RUN_DATE="${RUN_DATE:-$(date +%Y%m%d)}"
RUN_NAME="${RUN_NAME:-nersc_prod_london0_v1_${RUN_DATE}}"

# --- London-0 mock spectra (NERSC CFS) ---------------------------------------
MOCKDIR="/global/cfs/projectdirs/desi/mocks/lya_forest/london/qq_desi_y3/v5.9.5/mock-0/jura-124"
QSOCAT="${MOCKDIR}/zcat.fits"
RELEASE="v5.9.5"

# --- Output (writable scratch) -----------------------------------------------
OUTDIR="${OUTDIR:-${NERSC_OUTPUT_ROOT}/${RUN_NAME}/outputs/}"

# --- V1 candidate model (desicollab CFS) -------------------------------------
LEARNED_FILE="${NERSC_MODEL_ROOT}/2lpt_loa124_nohcd_nobal_wide_m/phase2_result.h5"

# --- NUM_FOREST_LINES must MATCH training (overrides _base.env default 3) -----
NUM_FOREST_LINES=31

# --- Absorber-mode knobs (V1 = 2-way single-absorber) ------------------------
MAX_DLAS=4
SINGLE_ABSORBER_MODEL=1
FILTER_LOW_LIKELIHOOD=1

# --- τ-EB ON / null objective (production best baseline) ---------------------
ENABLE_TAU_EB=1
TAU_EB_OBJECTIVE=null
EARLY_STOP_MODE=baseline

# --- MAX_LAMBDA override (V1: 1250 vs _base default 1216.75) -----------------
MAX_LAMBDA=1250

# --- PW prior (NHI 17.2-22.5). NUM_SAMPLES picks the grid + sample counts. ----
# Default 50000 = the chosen production PW (PW50k, hits 85/85 at ~half the PW100k
# cost; see README §runs). Override NUM_SAMPLES=100000 for the byte-identical-V1
# no-drift cross-check, or 30000/10000 for cheaper sweeps. Grids made by
# tools/make_subsampled_grids.py.
NUM_SAMPLES="${NUM_SAMPLES:-50000}"
NUM_DLA_SAMPLES="$NUM_SAMPLES"
NUM_SUBDLA_SAMPLES="$NUM_SAMPLES"
DLA_SAMPLES_FILE="${REPO_ROOT}/data/dr12q/processed/pw_samples_a3_172_225_${NUM_SAMPLES}.mat"
SUB_DLA_SAMPLES_FILE="${REPO_ROOT}/data/dr12q/processed/subdla_samples_a03_191_200_${NUM_SAMPLES}.mat"

# --- Parallelism (Perlmutter optimum from the 2026-06-01 sweep) --------------
MAX_WORKERS=8
BATCH_SIZE=1250

# --- Outer-loop window (London mock-0 has 1150 spectra-16 files) -------------
OUTER_MAX_INDEX=1150

# --- Truth catalog for downstream P/C eval (London uses dla_cat.fits) --------
TRUTH_CAT="${MOCKDIR}/dla_cat.fits"
TRUTH_NHI_MIN=20.3
BAL_CAT="${MOCKDIR}/bal_cat.fits"
